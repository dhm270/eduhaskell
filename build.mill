package build

import mill.*, scalalib.*

trait ComponentModule extends ScalaModule {
  def scalaVersion = "2.13.18"
   override def scalacOptions = Seq(
      "-deprecation",
      "-feature",
      "-unchecked"
    )
}

object EduHaskell extends ScalalrModule {
  override
  def scalaVersion = "2.13.18"
  def notation = "eduhaskell.scalalr"
  def unmanagedJars = "Assets"
  def scalalr = "Assets/scalalr"
  def mainClass = Some("RunEduHaskell")
  def releasePath = "eduhaskell"

  object test extends ScalaTests with TestModule.Munit {
    override def munitVersion: T[String] = "1.0.4"
  }
}


