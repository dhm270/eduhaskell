%notation EduHaskell
%package eduhaskell
%tables lr

%include {
    import org.sufrin.scalalr.{SourceLocation,ScannerCore,Scanner}
    import org.sufrin.utility.SourceTextCursor
    import eduhaskell.syntax.Quotation

    def hex(chars: Seq[Char]): Long  = chars.foldLeft(0L) { (acc, c) => acc * 16 + Character.digit(c, 16) }
    def dec(chars: Seq[Char]): Long  = chars.foldLeft(0L) { (acc, c) => acc * 10 + Character.digit(c, 10) }

    val predefinedSymbols =
        Seq(
            OPL2("||"), OPL3("&&"), OPL5("+"), OPL5("~"),
            OPL6("*"),  OPL6("/"),  OPL6("%")
        )  ++
        List("<", "<=", "==", ">", ">=").map(OPL4(_)) ++
        List(":").map(OPR1(_))

    private val operators = Map(predefinedSymbols.map{ case t: Token => (t.value: String, t) }: _*)

    /**
        `Scanner(chars)` builds a lexical scanner from a `ScannerCore`. The implementations of
        the `mkXXX` functions bridge the fixed lexical categories of the builder, and the `%token`
        constructors declared here. The `withSymbolTokens(symbolToken)` clause initialises the
        internal symbol map and prefixmap of the resulting builder.
    */


    def makeScanner(chars: SourceTextCursor): Scanner[Token] = new ScannerCore[Token](chars) {
        def mkString(openQuote: String, closeQuote: String, body: Seq[Char]): Token = STRING(Quotation(openQuote, body.mkString, closeQuote))
        def mkHex(source: Seq[Char]):          Token = INT(hex(source))
        def mkDec(source: Seq[Char]):          Token = INT(dec(source))
        def mkReal(source: Seq[Char]):         Token = REAL(source.mkString.toDouble)
        def mkIDENTIFIER(source: Seq[Char]):   Token = ID(source.mkString)
        def mkERROR(source: Seq[Char]):        Token = { LEXICALERROR(s"At ${chars.lines}.${chars.chars}: ${source.mkString}") }
        val NEWLINE:                    Option[Token] = Some(NL)
        override val ENDSTREAM: Token                = Scanner.ENDOFFILE

        override def eatComment(): Unit = {
            val loc = sourceLocation()
            var level = 1
            var lastChar = ' '
            nextChar()                      // skip the -
            while (hasChar && level!=0) {
                theChar match {
                    case '-' if lastChar == '{' => level += 1
                    case '}' if lastChar == '-' => level -= 1
                    case _                      => lastChar=theChar
                }
                nextChar()
            }
            if (level != 0) System.err.println(s"WARNING: nested (level $level) comment unclosed $loc")
            nextChar()
        }

        override def next(): Token = if (hasChar) {
            lastLocation = SourceLocation(chars.lines, chars.chars)
            theChar match {
                case c if c.isLetter =>
                    val prefix = chars.takeWhile(_.isLetterOrDigit)
                    val string = prefix.mkString("")
                    tokenMap.getOrElse(string, mkIDENTIFIER(string))

                case '0' =>
                    nextChar()
                    theChar.toLower match {
                        case 'x' =>
                            nextChar()
                            mkHex(chars.takeWhile(c => c.isDigit || ("abcdef" contains c.toLower)))
                        case other =>
                            nextNumber(chars.takeWhile(c => c.isDigit).prepended('0'))
                    }
                case c if c.isDigit =>
                    val intPart = chars.takeWhile(c => c.isDigit)
                    nextNumber(intPart)

                case '\u0004' =>
                    ENDSTREAM
                case '\u0000' =>
                    nextChar()
                    if (hasChar) next() else ENDSTREAM

                // When a newline appears return NEWLINE (if it's defined) without actually reading ahead.
                // and pretend that the read ahead got a nul, so that the subsequent next() skips this nul
                case c if c == '\n' && allowNL =>
                    chars.current = '\u0000'
                    if (NEWLINE.isDefined) NEWLINE.get else next()

                case c if c.isWhitespace =>
                    while (hasChar && theChar.isWhitespace) nextChar()
                    if (hasChar) next() else ENDSTREAM

                case '{' => // ScalaLR gets a bit confused because of the open bracket in this line. So we need this to fix it: }
                    nextChar()
                    theChar match {
                        case '-' =>
                            eatComment()
                            next()
                        case other =>
                            tokenPrefixMap.longestPrefixMatch(s"{$other") match { // As above: }
                                case None => mkERROR(s"at: {$other") // As above: }
                                case Some((tok, edges)) =>
                                    tok
                            }
                    }
                
                case '-' =>
                    nextChar()
                    theChar match {
                        case '-' =>
                            chars.dropWhile(c => c != '\n')
                            next()
                        case other =>
                            tokenPrefixMap.longestPrefixMatch(s"-$other") match {
                                case None => mkERROR(s"at: -$other")
                                case Some((tok, edges)) => {
                                    if (tok.toString == "-") { tok } else { afterNextChar(tok) }
                                }
                            }
                    }

                case '«' =>
                    nextChar(); afterNextChar(mkString("«", "»", chars.takeNested2('«', '»')))
                case '“' =>
                    nextChar(); afterNextChar(mkString("“", "“", chars.takeNested2('“', '“')))
                case '"' =>
                    nextChar(); afterNextChar(mkString("\"", "\"", chars.takeWhile(c => c != '"')))
                case '\'' =>
                    nextChar(); afterNextChar(mkString("'", "'", chars.takeWhile(c => c != '\'')))

                case c =>
                    tokenPrefixMap.longestPrefixMatch(chars) match {
                        case None =>
                            nextChar()
                            mkERROR(s"No token starting `$c` [${c.toInt}] can be completed here.")
                        case Some((tok, edges)) =>
                            tok
                    }
            }
        } else ENDSTREAM

        locally {
            defineSymbolTokens(symbolToken ++ operators)
        }

        def flush(): Unit = {
            while (chars.hasCurrent && chars.current != '\n') chars.next()
            chars.prompt()
        }
    } withSymbolTokens(symbolToken)

}

%token ID(String) INT(Long) REAL(Double) STRING(eduhaskell.syntax.Quotation) NL LEXICALERROR(String) ENDOFFILE
%token `where` `{` `}` `(` `)` `;` `,` `[` `]` `_` `\` `|` `->` `<-`
%token `if` `then` `else` `let` `in` `case` `of`

%prec  LOWEST
%non   `=`
%non   '::'
%non   OPN0(String)
%right OPR1(String)
%left  OPL2(String)
%left  OPL3(String)
%non   OPL4(String)
%left  OPL5(String) '-'
%left  OPL6(String)
%left  OPL7(String)
%left  OPL8(String)
%left  OPL9(String)
%left  APPLY
%prec  HIGHEST

%rules

%include {
    import org.sufrin.scalalr.Shortcut._
    import eduhaskell.syntax._
    import org.sufrin.utility.PrettyPrint._

    def translate(clause: TREE): TREE = {
        import eduhaskell.visitor.Visitors._
        import eduhaskell.visitor.Dispatch._
        clause match {
            case it: Expr => it.visit(DetupleExpression)
            case it: Definition => it.visit(DetupleDefinition)
        }
    }

    def layout(clause: TREE): TREE = {
        import eduhaskell.visitor.Dispatch._
        import eduhaskell.visitor.Formatting._
        val scheme = clause match {
            case it: Expr => ExprFormat(it)
            case it: Definition => DefinitionFormat(it)
        }
        println("----------")
        println(scheme.render(40))
        println("----------")
        clause
    }

    def MakeEquation(lhs: Expr, rhs: Expr): Definition = {
        rhs match {
            case Where(expression, equations) => WhereEquation(lhs, expression, equations)
            case _                            => Equation(lhs, rhs)
        }
    }
}

program: Unit = (NL)? (anAction NL)+ ENDOFFILE { () }

anAction: Shortcut = onePhrase { layout($onePhrase); translate($onePhrase).prettyPrint(); Instruct($onePhrase) }
                     | ENDOFFILE { Accept(()) }

onePhrase: TREE = expr | equation | typeDef | guardedEquation

maybeEOL: () = %empty { () }
               | NL { () }

SEMI: () = ';' { () }
           | NL { () }
           | ';' NL { () }

whereExpr: Expr = expr { $expr }
                  | expr `where` equation { Where($expr, List($equation)) }
                  | expr `where` '{' maybeEOL equations maybeEOL '}' { Where($expr, $equations.reverse) }

equations: List[Definition] = equations SEMI equation { $equation :: $equations }
                              | equation { List($equation) }

equation: Definition = lhs:pattern '=' maybeEOL rhs:whereExpr { MakeEquation($lhs, $rhs) }

expr: Expr = cases | lambda | expression

lambda: Expr = '\' pattern:pattern guard:(guard)? '->' maybeEOL expression:expr { Function(List(PartialFun($pattern, $guard, $expression))) }

pattern: Expr = expression

expression: Expr = application
                   | binopExpression
                   | 'if' condition:expression maybeEOL 'then' maybeEOL trueExpr:expression maybeEOL 'else' maybeEOL falseExpr:expression { If($condition, $trueExpr, $falseExpr) }
                   | letExpression
                   | caseExpression

caseExpression: Expr = 'case' maybeEOL query:expression maybeEOL 'of' maybeEOL alt { Case($query, List($alt)) }
                       | 'case' maybeEOL query:expression maybeEOL 'of' maybeEOL '{' maybeEOL alts maybeEOL '}' { Case($query, $alts) }

alts: List[(Expr, Expr)] = alt { List($alt) }
                           | alt SEMI alts { $alt :: $alts }

alt: (Expr, Expr) = pattern:pattern '->' expression { ($pattern, $expression) }

letExpression: Expr = 'let' equation 'in' maybeEOL expr { Where($expr, List($equation)) }
                      | 'let' '{' maybeEOL equations maybeEOL '}' maybeEOL 'in' maybeEOL expr { Where($expr, $equations.reverse) }

binopExpression: Expr = l:expression op:OPN0 maybeEOL r:expression { Binop($op, $l, $r) }
                        | l:expression op:OPR1 maybeEOL r:expression { Binop($op, $l, $r) }
                        | l:expression op:OPL2 maybeEOL r:expression { Binop($op, $l, $r) }
                        | l:expression op:OPL3 maybeEOL r:expression { Binop($op, $l, $r) }
                        | l:expression op:OPL4 maybeEOL r:expression { Binop($op, $l, $r) }
                        | l:expression op:OPL5 maybeEOL r:expression { Binop($op, $l, $r) }
                        | l:expression '-' maybeEOL r:expression { Binop("-", $l, $r) }
                        | l:expression op:OPL6 maybeEOL r:expression { Binop($op, $l, $r) }
                        | l:expression op:OPL7 maybeEOL r:expression { Binop($op, $l, $r) }
                        | l:expression op:OPL8 maybeEOL r:expression { Binop($op, $l, $r) }
                        | l:expression op:OPL9 maybeEOL r:expression { Binop($op, $l, $r) }

application: Expr = l:application r:simpleExpression { Apply($l, $r) } %prec APPLY
                    | '-' simpleExpression { Prefix("-", $simpleExpression) }
                    | simpleExpression

simpleExpression: Expr = ID { Id($ID) }
                         | INT { Num($INT) }
                         | REAL { Real($REAL) }
                         | STRING { Quote($STRING) }
                         | '(' ')' { Tuple(Nil) }
                         | '[' ']' { Sequence(Nil) }
                         | '(' maybeEOL expressions maybeEOL ')' { Tuple($expressions) }
                         | '[' maybeEOL expressions maybeEOL ']' { Sequence($expressions) }
                         | '[' maybeEOL expression maybeEOL '|' maybeEOL qualifiers maybeEOL ']' { SequenceComprehension($expression, $qualifiers) }
                         | error => ()

qualifiers: List[(Expr, Expr)] = qualifier { List($qualifier) }
                                 | qualifier maybeEOL ',' maybeEOL qualifiers { $qualifier :: $qualifiers }

qualifier: (Expr, Expr) = pattern:pattern '<-' expression { ($pattern, $expression) }

guardedEquation: GuardedEquation = pattern:pattern '|' rhss:RHSs where:whereClause { GuardedEquation($pattern, $rhss, $where) }

RHS: GuardedResult = guard:expression '=' maybeEOL expression:expr { GuardedResult($guard, $expression) }
                     | error => ()

RHSs: List[GuardedResult] = rhs: RHS NL { List($rhs) }
                            | rhs: RHS NL '|' rhss: RHSs { $rhs :: $rhss }

whereClause: List[Definition] = `where` maybeEOL equation { List($equation) }
                                | `where` maybeEOL '{' maybeEOL equations maybeEOL '}' { $equations.reverse }
                                | %empty { Nil }

cases: Function = '{' alts:partialFunctions maybeEOL '}' { Function($alts.reverse) }

partialFunctions: List[PartialFun] = partialFunction { List($partialFunction) }
                                     | partialFunctions maybeEOL '|' partialFunction { $partialFunction :: $partialFunctions }
                                     | %empty { Nil }

partialFunction: PartialFun = pattern:pattern guard:(guard)? '->' expression:expr { PartialFun($pattern, $guard, $expression) } %prec HIGHEST

guard: Expr = '|' expr

expressions: List[Expr] = expr ',' maybeEOL expressions => $expr :: $expressions
                          | expr { List($expr) }

typeDef: TypeDef = symbols: (symbol ',')+ '::' typeExpr => TypeDef($symbols, $typeExpr)

typeExpr: Expr = l:typeExpr "->" r:typeExpr { Binop("->", $l, $r) }
                 | ID { Id($ID) }
                 | '(' typeExprs ')' { Tuple($typeExprs) }
                 | '[' typeExpr ']' { Sequence(List($typeExpr)) }

typeExprs: List[Expr] = typeExpr ',' typeExprs { $typeExpr :: $typeExprs }
                        | typeExpr { List($typeExpr) }

infix: String = op:OPN0
                | op:OPR1
                | op:OPL2
                | op:OPL3
                | op:OPL4
                | op:OPL5
                | op:OPL6
                | op:OPL7
                | op:OPL8
                | op:OPL9

symbol: Expr = ID { Id($ID) }
               | '(' infix ')' { Op($infix) } %prec HIGHEST
